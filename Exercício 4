valor = float(input("Valor financiado: "))
taxa = float(input("Taxa mensal: "))
parcela = float(input("Valor da parcela: "))
meses = int(input("Máximo de meses: "))

saldo = valor
totalpago = 0
juros = 0
mes = 0

while saldo > 0 and mes < meses:

    j = saldo * taxa / 100
    saldo = saldo + j
    juros = juros + j

    if parcela >= saldo:
        totalpago = totalpago + saldo
        saldo = 0
    else:
        saldo = saldo - parcela
        totalpago = totalpago + parcela

    mes = mes + 1

    print("Mês:", mes)
    print("Saldo:", saldo)

    if parcela <= j and saldo > 0:
        print("A parcela não é suficiente")
        break

print("Total de meses:", mes)
print("Total pago:", totalpago)
print("Total de juros:", juros)
print("Saldo restante:", saldo)

if saldo == 0:
    print("Financiamento quitado")
else:
    print("Financiamento não foi quitado")
