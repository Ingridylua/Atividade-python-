valor = float(input("Valor da compra: "))
maximo = int(input("Quantidade máxima de parcelas: "))
taxa = float(input("Taxa de juros mensal: "))
limite = float(input("Limite para o valor da parcela: "))

for meses in range(1, maximo + 1):

    juros = valor * taxa / 100 * meses
    total = valor + juros
    parcela = total / meses

    print(meses, "x de R$", parcela)
    print("Total:", total)
    print("Juros:", juros)

    if parcela < limite:
        print("Essa parcela é menor que o limite")
