a = 0
b = 0
c = 0
branco = 0
nulo = 0

voto = -1

while voto != 0:

    print("1 - Candidato A")
    print("2 - Candidato B")
    print("3 - Candidato C")
    print("4 - Branco")
    print("5 - Nulo")
    print("0 - Encerrar")

    voto = int(input("Digite seu voto: "))

    if voto == 1:
        a = a + 1
    elif voto == 2:
        b = b + 1
    elif voto == 3:
        c = c + 1
    elif voto == 4:
        branco = branco + 1
    elif voto == 5:
        nulo = nulo + 1
    elif voto != 0:
        print("Voto inválido")

total = a + b + c + branco + nulo
validos = a + b + c
invalidos = branco + nulo

print("Candidato A:", a)
print("Candidato B:", b)
print("Candidato C:", c)
print("Votos brancos:", branco)
print("Votos nulos:", nulo)
print("Total de votos:", total)

if total > 0:
    print("A:", a * 100 / total, "%")
    print("B:", b * 100 / total, "%")
    print("C:", c * 100 / total, "%")
    print("Votos válidos:", validos * 100 / total, "%")
    print("Votos inválidos:", invalidos * 100 / total, "%")

if a > b and a > c:
    print("Vencedor: Candidato A")
elif b > a and b > c:
    print("Vencedor: Candidato B")
elif c > a and c > b:
    print("Vencedor: Candidato C")
else:
    print("Houve empate")
